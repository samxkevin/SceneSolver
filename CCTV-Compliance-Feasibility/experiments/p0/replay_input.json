  "rule": {
    "id": "p0_zone_dwell",
    "version": 1,
    "unknown_policy": "delay",
    "when": {"temporal": {"operator": "for_at_least", "subject": {"event": "person.inside_zone", "args": {"zone": "restricted", "subject": "p1"}}, "duration": "3s", "max_gap": "1s"}},
    "then": {"event_type": "compliance.violation", "action": ["evidence_capture"], "cooldown": "30s"}
  }
}
