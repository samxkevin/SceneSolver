      "events": [
        {
          "event_id": "a1",
          "event_type": "person.entered_zone",
          "start_s": 1,
          "end_s": 1,
          "attributes": {
            "zone": "restricted",
            "subject": "p1"
          }
        },
        {
          "event_id": "a2",
          "event_type": "authorization.status",
          "start_s": 1,
