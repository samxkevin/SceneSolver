      "id": "zone_entry_dwell_confirmed",
      "expected_decision": "confirmed",
      "expected_raw_status": "true",
      "rule": {
        "id": "restricted_zone_dwell",
        "version": 1,
        "unknown_policy": "delay",
        "when": {
          "temporal": {
            "operator": "for_at_least",
            "subject": {
              "event": "person.inside_zone",
              "args": {
                "zone": "restricted",
                "subject": "p1"
              }
            },
            "duration": "10s",
            "max_gap": "2s"
          }
        },
        "then": {
          "event_type": "compliance.violation",
