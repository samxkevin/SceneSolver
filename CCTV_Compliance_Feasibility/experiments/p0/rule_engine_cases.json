      "id": "exception_authorization_suppresses",
      "expected_decision": "suppressed_by_exception",
      "expected_raw_status": "true",
      "rule": {
        "id": "restricted_zone_authorization",
        "version": 1,
        "exceptions": [
          {
            "predicate": "exception.active",
            "args": {
              "rule_id": "restricted_zone",
              "equals": true
            }
          }
        ],
        "when": {
          "all": [
            {
              "event": "person.entered_zone",
              "args": {
                "zone": "restricted",
                "subject": "p1"
              }
            },
            {
              "predicate": "authorization.status",
              "args": {
                "subject": "p1",
                "equals": "unauthorized"
              }
            }
          ]
        },
        "then": {
          "event_type": "restricted.zone.violation",
          "action": [
            "human_review"
          ]
        }
